rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The contact form is the only public writer. Writes are create-only and
    // must match the exact shape the form sends, with length caps so the
    // collection cannot be used as free storage. Reads stay closed: messages
    // are consumed by the Cloud Function and the Firebase console.
    match /messages/{messageId} {
      allow read, update, delete: if false;

      allow create: if request.resource.data.keys().hasOnly(
                         ['name', 'email', 'message', 'lang', 'createdAt', 'status', 'emailNotified'])
                    && request.resource.data.keys().hasAll(
                         ['name', 'email', 'message', 'lang', 'createdAt', 'status', 'emailNotified'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 1
                    && request.resource.data.name.size() <= 120
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.email.matches('^[^@\s]+@[^@\s]+\.[^@\s]+$')
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 10
                    && request.resource.data.message.size() <= 5000
                    && request.resource.data.lang in ['en', 'ar']
                    && request.resource.data.createdAt is string
                    && request.resource.data.status == 'unread'
                    && request.resource.data.emailNotified == false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
